# DevVault — Supabase Environment Configuration
# Copy this file to .env.local and populate with your project credentials:
# cp .env.example .env.local

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous / Publishable Key (safe for browser client with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Environment identifier (development | production)
NEXT_PUBLIC_APP_ENV=development

# 4. Optional: Custom Vault Domain / Site URL for Auth Redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WARNING: NEVER define SUPABASE_SERVICE_ROLE_KEY or database root passwords in client-facing .env files.
# All client requests must pass through Row Level Security (RLS) via the anon key.
